{
  "name": "taxi-service",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:api": "dotenv -e .env -- pnpm --filter api dev",
    "dev:bot": "dotenv -e .env -- pnpm --filter bot dev",
    "db:migrate": "dotenv -e .env -- pnpm --filter db migrate:dev",
    "db:seed": "dotenv -e .env -- pnpm --filter db seed",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
